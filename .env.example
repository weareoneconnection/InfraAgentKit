# Copy to .env (or set in your platform) only if you need to change the defaults.
INFRAAGENTKIT_DB=./data/infraagentkit.db
# Directory of Agent Card YAML files (default: examples/agents)
INFRAAGENTKIT_AGENTS=
# Optional OpenAI-compatible model for planning and findings (DeepSeek, Qwen, OpenAI, Ollama, ...).
# Leave empty for the deterministic rules mode the benchmark measures.
INFRAAGENTKIT_MODEL_BASE_URL=
INFRAAGENTKIT_MODEL=
INFRAAGENTKIT_MODEL_API_KEY=
